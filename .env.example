# Gemini (Google Generative Language API — OpenAI-compatible endpoint)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# PostgreSQL — full connection URL for the read-only role.
# Works with Neon, Render, Supabase, local Postgres, etc.
# Neon: keep ?sslmode=require — the app strips it and sets SSL automatically.
READONLY_DATABASE_URL=postgresql://readonly_user:readonly_pass@host:5432/analyst_db?sslmode=require

# Optional — full URL for the admin role (only needed if you use admin engine).
# If omitted, the app falls back to READONLY_DATABASE_URL.
# ADMIN_DATABASE_URL=postgresql://postgres:postgres@host:5432/analyst_db?sslmode=require

# App
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MAX_RETRIES=3
MAX_STEPS=4
MAX_QUERY_ROWS=500
MAX_QUESTION_LENGTH=500
RATE_LIMIT=15/minute
