# Gemini (Google Generative Language API — OpenAI-compatible endpoint)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# PostgreSQL (read-write — for schema init only)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=analyst_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PostgreSQL READ-ONLY user (used exclusively by sql_executor)
POSTGRES_READONLY_USER=readonly_user
POSTGRES_READONLY_PASSWORD=readonly_pass

# App
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
MAX_RETRIES=3
MAX_STEPS=4
MAX_QUERY_ROWS=500
MAX_QUESTION_LENGTH=500
RATE_LIMIT=15/minute
